  "main": "index.js",
  "scripts": {
    "dev": "bash scripts/dev-frontend.sh",
    "dev:env": "bash scripts/dev-up.sh",
    "test": "node scripts/salo-checks.mjs test",
    "test:tooling": "node --test tests/ai-tooling.test.mjs tests/development-workflow.test.mjs",
    "test:browser:cloud": "node scripts/salo-checks.mjs browser --browser system-chromium",
    "quality:skills": "node scripts/salo-checks.mjs skills",
    "quality:config": "node scripts/salo-checks.mjs config",
    "quality:scan": "node scripts/salo-checks.mjs scan",
    "quality:types": "node scripts/salo-checks.mjs typecheck",
    "quality:prisma": "node scripts/salo-checks.mjs prisma",
    "quality:integrity": "node scripts/salo-checks.mjs integrity",
    "test:browser:mock": "node scripts/test-browser-mock.mjs",
    "test:backend:unit": "node scripts/test-backend-unit.mjs",
    "test:workflow": "node --test tests/development-workflow.test.mjs",
    "quality:capture": "node scripts/quality-gate.mjs --capture",
    "quality:fast": "node scripts/quality-gate.mjs --mode fast",
    "quality:finish": "node scripts/quality-gate.mjs --mode finish",
    "quality:review": "node scripts/quality-gate.mjs --mode review",
    "serve": "python3 -m http.server 8000",
    "cap:sync": "npx cap sync",
    "cap:doctor": "npx cap doctor",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:debug": "npx cap sync && cd android && ./gradlew assembleDebug",
    "android:release": "npx cap sync && cd android && ./gradlew assembleRelease",
    "ios:build": "echo 'iOS build requires macOS + Xcode; run: npx cap open ios'"
  },
