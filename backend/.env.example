# --- Runtime ---
DATABASE_URL="postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5432/REPLACE_WITH_DATABASE"
PORT=4000
APP_URL="http://localhost:4000"
# Comma separated list of trusted browser origins (production frontends).
CORS_ORIGINS="https://app.example.com,https://www.example.com"
NODE_ENV="production"

# --- Authentication (required, no defaults) ---
JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_REFRESH_SECRET="replace-with-long-random-string"

# --- Email delivery (names only, values supplied at deploy time) ---
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM_EMAIL="no-reply@example.com"
EMAIL_DELIVERY_MODE="resend"
VERIFICATION_HMAC_KEY="replace-with-long-random-string"

# --- Push notification configuration (production) ---
FCM_SERVER_KEY="replace-with-fcm-server-key"
APNS_KEY_ID="replace-with-apns-key-id"
APNS_TEAM_ID="replace-with-apns-team-id"
APNS_BUNDLE_ID="com.example.salon"
APNS_AUTH_KEY="replace-with-apns-auth-key-or-private-key-content"
