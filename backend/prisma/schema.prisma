generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                          @id @default(uuid())
  email                     String                          @unique
  phone                     String?
  fullName                  String
  passwordHash              String?
  role                      UserRole                        @default(CUSTOMER)
  status                    UserStatus                      @default(ACTIVE)
  emailVerified             Boolean                         @default(false)
  phoneVerified             Boolean                         @default(false)
  avatarUrl                 String?
  locale                    String                          @default("ar")
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  deletedAt                 DateTime?
  analyticsEvents           AnalyticsEvent[]
  bookings                  Booking[]
  deviceTokens              DeviceToken[]
  loyaltyCustomers          LoyaltyCustomer[]
  loyaltyStamps             LoyaltyStamp[]
  receivedMessages          Message[]                       @relation("MessageReceiver")
  sentMessages              Message[]                       @relation("MessageSender")
  notifications             Notification[]
  passwordResets            PasswordReset[]
  reviews                   Review[]
  ownedSalons               Salon[]
  serviceVisitsStarted      ServiceVisit[]                 @relation("ServiceVisitStartedBy")
  serviceVisitsCompleted    ServiceVisit[]                 @relation("ServiceVisitCompletedBy")
  serviceVisitsCancelled    ServiceVisit[]                 @relation("ServiceVisitCancelledBy")
  staffMemberships          StaffMembership[]
  staffPresenceChanges      StaffPresence[]                 @relation("StaffPresenceChangedBy")
  availabilitySubscriptions SalonAvailabilitySubscription[]
  sessions                  Session[]
  subscriptions             UserSubscription?
queueEntries QueueEntry[]
}

model UserSubscription {
  id                String             @id @default(uuid())
  userId            String             @unique
  plan              SubscriptionPlan   @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  monthlyPrice      Decimal?           @db.Decimal(10, 2)
  startDate         DateTime?
  renewalDate       DateTime?
  cancellationDate  DateTime?
  providerReference String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Intentional scalar snapshots: evidence must survive deletion of Salon/User.
model SalonEnforcement {
  id               String   @id @default(uuid()) @db.Uuid
  salonId          String
  salonName        String
  ownerUserId      String
  reason           String
  actorUserId      String
  enforcedAt       DateTime @default(now())
  previousIsActive Boolean
  subscription     Json?

  @@index([salonId, enforcedAt])
}
// Intentional scalar snapshot: archive evidence must survive deletion of Salon/User.
// Scalar snapshots deliberately survive Salon/User removal.
model SalonRetentionHold {
  id                   String    @id @default(uuid()) @db.Uuid
  salonId              String
  reason               String
  actorUserId          String
  createdAt            DateTime  @default(now())
  releasedAt           DateTime?
  releasedByUserId     String?
  releaseReason        String?

  @@index([salonId, releasedAt])
}

model SalonPurgeClearance {
  id                   String    @id @default(uuid()) @db.Uuid
  salonId              String
  archiveId            String    @db.Uuid
  archiveVersion       Int
  payloadVersion       Int
  archiveFinalizedAt   DateTime
  sourceState          Json
  coverage             Json
  actorUserId          String
  issuedAt             DateTime  @default(now())
  revokedAt            DateTime?
  revokedByUserId      String?
  revocationReason     String?

  @@index([salonId, revokedAt])
  @@index([archiveId])
}

model SalonArchive {
  archiveId      String    @id @default(uuid()) @db.Uuid
  salonId        String
  salonName      String
  ownerUserId    String
  archiveVersion Int       @default(1)
  payloadVersion Int       @default(1)
  coverage       Json
  sourceState    Json
  evidence       Json?
  source         String
  finalizedAt    DateTime
  createdAt      DateTime  @default(now())

  @@index([salonId, finalizedAt])
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  platform   DevicePlatform
  token      String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, isActive])
}

model Salon {
  id                        String                          @id @default(uuid())
  ownerId                   String
  name                      String
  slug                      String                          @unique
  city                      String
  address                   String
  latitude                  Float?
  longitude                 Float?
  phone                     String
  email                     String?
  website                   String?
  description               String?
  isVip                     Boolean                         @default(false)
  adminVip                  Boolean                         @default(false)
  classification            SalonClassification             @default(REGULAR)
  isWomenOnly               Boolean                         @default(false)
  isActive                  Boolean                         @default(true)
  status                    SalonStatus                     @default(OPEN)
  bookingIntakeEnabled    Boolean @default(true)
  saloTicketIntakeEnabled Boolean @default(true)
  walkInIntakeEnabled     Boolean @default(true)
  rating                    Float                           @default(0)
  reviewCount               Int                             @default(0)
  openingTime               String?
  closingTime               String?
  workingDays               String[]                        @default([])
  timeZone                  String?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  analyticsEvents           AnalyticsEvent[]
  availability              AvailabilitySlot[]
  barbers                   Barber[]
  bookings                  Booking[]
  loyaltyCards              LoyaltyCard[]
  messages                  Message[]
  offers                    Offer[]
  reviews                   Review[]
  owner                     User                            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  availabilitySubscriptions SalonAvailabilitySubscription[]
  boostPlacement            SalonBoost?
  media                     SalonMedia[]
  services                  Service[]
  liveStatus                SalonLiveStatus?
  staffMemberships          StaffMembership[]
  serviceVisits             ServiceVisit[]
queueEntries QueueEntry[]
}

model SalonLiveStatus {
  salonId          String    @id
  operationalState String?
  observedAt       DateTime?
  expiresAt        DateTime?
  source           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  salon            Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonBoost {
  id                String      @id @default(uuid())
  salonId           String      @unique
  status            BoostStatus @default(ACTIVE)
  durationDays      Int         @default(7)
  startsAt          DateTime?
  endsAt            DateTime?
  amountCents       Int?        @default(0)
  currency          String?     @default("EUR")
  providerReference String?
  paymentIntentId   String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  salon             Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
}

model LoyaltyCard {
  id             String            @id @default(uuid())
  salonId        String
  isActive       Boolean           @default(true)
  requiredStamps Int               @default(8)
  rewardType     LoyaltyRewardType @default(FREE_SERVICE)
  rewardTitle    String            @default("Free haircut")
  rewardText     String            @default("Free haircut")
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  salon          Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customers      LoyaltyCustomer[]
  stamps         LoyaltyStamp[]
}

model LoyaltyCustomer {
  id               String      @id @default(uuid())
  cardId           String
  customerId       String
  currentStamps    Int         @default(0)
  totalVisits      Int         @default(0)
  lastStampedAt    DateTime?
  rewardRedeemedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  card             LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customer         User        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([cardId, customerId])
}

model LoyaltyStamp {
  id                String      @id @default(uuid())
  cardId            String
  customerId        String
  barberId          String?
  transactionId     String      @unique
  stampAt           DateTime    @default(now())
  isValid           Boolean     @default(true)
  verificationToken String?
  createdAt         DateTime    @default(now())
  card              LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customer          User        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([cardId, customerId])
  @@index([transactionId])
}

model Barber {
  id              String           @id @default(uuid())
  salonId         String
  name            String
  specialty       String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  slots           AvailabilitySlot[]
  salon           Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  staffMembership StaffMembership?

  @@unique([id, salonId])
}

model StaffMembership {
  id        String                @id @default(uuid())
  userId    String
  salonId   String
  barberId  String                @unique
  status    StaffMembershipStatus @default(ACTIVE)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  revokedAt DateTime?
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon     Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber    Barber                @relation(fields: [barberId, salonId], references: [id, salonId], onDelete: Cascade)
  presence  StaffPresence?
  serviceVisits ServiceVisit[]

  @@unique([userId, salonId])
  @@unique([id, salonId])
  @@unique([barberId, salonId])
  @@index([salonId, status])
}

model StaffPresence {
  staffMembershipId String                    @id
  dutyState         StaffDutyState
  generation        Int
  changedAt         DateTime
  changedByUserId   String?
  changeSource      StaffPresenceChangeSource
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  staffMembership   StaffMembership           @relation(fields: [staffMembershipId], references: [id], onDelete: Cascade)
  changedBy         User?                     @relation("StaffPresenceChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  leases            StaffPresenceLease[]

  @@index([changedByUserId])
}

model StaffPresenceLease {
  id                String                      @id @default(uuid())
  staffMembershipId String
  generation        Int
  evidenceSource    StaffPresenceEvidenceSource
  producerKey       String
  observedAt        DateTime
  validUntil        DateTime
  revokedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  presence          StaffPresence               @relation(fields: [staffMembershipId], references: [staffMembershipId], onDelete: Cascade)

  @@unique([staffMembershipId, evidenceSource, producerKey], map: "StaffPresenceLease_source_key")
  @@index([staffMembershipId, generation, validUntil])
}

model Service {
  id          String    @id @default(uuid())
  salonId     String
  name        String
  description String?
  durationMin Int
  price       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id        String     @id @default(uuid())
  salonId   String
  barberId  String?
  startAt   DateTime
  endAt     DateTime
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  barber    Barber?    @relation(fields: [barberId], references: [id])
  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, barberId, startAt])
  @@index([salonId, startAt])
}

model Booking {
  id                 String        @id @default(uuid())
  userId             String
  salonId            String
  barberId           String?
  serviceId          String?
  startAt            DateTime
  endAt              DateTime
  status             BookingStatus @default(PENDING)
  notes              String?
  customerName       String?
  customerPhone      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?
  barber             Barber?       @relation(fields: [barberId], references: [id])
  salon              Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service            Service?      @relation(fields: [serviceId], references: [id])
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceVisit       ServiceVisit?

  @@unique([id, salonId])
  @@index([salonId, startAt])
  @@index([userId, createdAt])
}

model ServiceVisit {
  id                String             @id @default(uuid())
  salonId           String
  bookingId         String?            @unique
  staffMembershipId String
  source            ServiceVisitSource
  status            ServiceVisitStatus
  startedAt         DateTime
  completedAt       DateTime?
  cancelledAt       DateTime?
  version           Int                @default(1)
  startedByUserId   String?
  completedByUserId String?
  cancelledByUserId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  salon             Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking           Booking?           @relation(fields: [bookingId, salonId], references: [id, salonId], onDelete: Restrict)
  staffMembership   StaffMembership    @relation(fields: [staffMembershipId, salonId], references: [id, salonId], onDelete: Restrict)
  startedBy         User?              @relation("ServiceVisitStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completedBy       User?              @relation("ServiceVisitCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cancelledBy       User?              @relation("ServiceVisitCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
queueEntry QueueEntry?
  @@unique([bookingId, salonId])
  @@index([salonId, status, startedAt])
  @@index([staffMembershipId, status])
  @@index([startedByUserId])
  @@index([completedByUserId])
  @@index([cancelledByUserId])
}
enum QueueEntrySource {
  SALO_TICKET
  MANUAL_WALK_IN
}

enum QueueEntryStatus {
  WAITING
  CALLED
  STARTED
  CANCELLED
  EXPIRED
  NO_SHOW
}

model QueueEntry {
  id             String           @id @default(uuid())
  salonId        String
  customerId     String?
  serviceVisitId String?          @unique
  source         QueueEntrySource
  status         QueueEntryStatus @default(WAITING)
  joinedAt       DateTime
  calledAt       DateTime?
  startedAt      DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  noShowAt       DateTime?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
salon        Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
customer     User?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
serviceVisit ServiceVisit? @relation(fields: [serviceVisitId], references: [id], onDelete: Restrict)
  @@index([salonId, status, joinedAt])
  @@index([customerId, status])
}
model Offer {
  id             String    @id @default(uuid())
  salonId        String?
  title          String
  description    String?
  price          Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  availableSlots Int?
  discount       Decimal?  @db.Decimal(10, 2)
  endAt          DateTime?
  endTime        String?
  serviceName    String?
  startAt        DateTime?
  startTime      String?
  salon          Salon?    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  salonId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, salonId])
}

model Message {
  id         String   @id @default(uuid())
  salonId    String?
  senderId   String?
  receiverId String?
  subject    String?
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User?    @relation("MessageReceiver", fields: [receiverId], references: [id])
  salon      Salon?   @relation(fields: [salonId], references: [id])
  sender     User?    @relation("MessageSender", fields: [senderId], references: [id])
}

model SalonMedia {
  id        String   @id @default(uuid())
  salonId   String
  kind      String   @default("image")
  url       String
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String
  refreshToken String?
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  codeDigest        String?
  generation        Int       @default(1)
  deliveryState     String    @default("PENDING")
  providerMessageId String?
  attemptCount      Int       @default(0)
  sendCount         Int       @default(0)
  lastSendAt        DateTime?
  verifiedAt        DateTime?
  invalidatedAt     DateTime?
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  salonId   String
  userId    String?
  eventType String
  source    String   @default("app")
  metadata  Json?
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([salonId, createdAt])
  @@index([eventType, createdAt])
}

model SalonAvailabilitySubscription {
  id                       String                  @id @default(uuid())
  userId                   String
  salonId                  String
  status                   AvailabilityWatchStatus @default(ACTIVE)
  lastKnownAvailableChairs Int                     @default(0)
  lastNotifiedAt           DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  salon                    Salon                   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, salonId])
  @@index([userId, status])
  @@index([salonId, status])
}

enum UserRole {
  CUSTOMER
  OWNER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum StaffMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum StaffDutyState {
  ON_DUTY
  OFF_DUTY
}

enum StaffPresenceChangeSource {
  STAFF
  OWNER
  SYSTEM
}

enum StaffPresenceEvidenceSource {
  STAFF_APP
  OWNER
  SALO_STATION
  SERVICE_EVENT
}

enum ServiceVisitSource {
  BOOKING
  WALK_IN
}

enum ServiceVisitStatus {
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum SalonStatus {
  OPEN
  BUSY
  QUIET
  CLOSED
}

enum SalonClassification {
  REGULAR
  PREMIUM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum SubscriptionPlan {
  FREE
  SMART
  PREMIUM
  PRO
}

enum LoyaltyRewardType {
  FREE_SERVICE
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BoostStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AvailabilityWatchStatus {
  ACTIVE
  FIRED
  CANCELLED
}

// Registration proofs do not require a User until consumption.
model RegistrationVerificationChallenge {
  id                         String    @id
  channel                    String
  purpose                    String
  destination                String
  codeDigest                 String?
  generation                 Int
  deliveryState              String
  providerMessageId          String?
  expiresAt                  DateTime
  attemptCount               Int       @default(0)
  sendCount                  Int       @default(0)
  lastSendAt                 DateTime
  verifiedAt                 DateTime?
  registrationTokenHash      String?
  registrationTokenExpiresAt DateTime?
  consumedAt                 DateTime?
  invalidatedAt              DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([destination, purpose])
  @@index([expiresAt])
}

model VerificationRateLimitBucket {
  id        String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
